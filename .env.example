# ─── Supabase ──────────────────────────────────────────────
# Remplacer par les credentials de votre projet Supabase

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-clé-anon-publique
SUPABASE_SERVICE_ROLE_KEY=votre-clé-service-role
# Mot de passe PostgreSQL (Settings → Database → Reset database password)
SUPABASE_DB_PASSWORD=votre-mot-de-passe-db
# Pooler IPv4 (optionnel, détecté automatiquement si absent)
# ex: aws-0-eu-west-3.pooler.supabase.com
SUPABASE_DB_HOST=

# ─── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://verif.escen-university.fr

# ─── CAPTCHA (Cloudflare Turnstile, anti-robot) ─────────────
# ⚠️ Configurer les DEUX clés ensemble (dash.cloudflare.com → Turnstile) :
#    si une seule est définie, le widget s'affiche sans être exigé (ou l'inverse).
# Clé publique (côté client, sûre) — vide en dev → CAPTCHA désactivé
NEXT_PUBLIC_TURNSTILE_SITE_KEY=votre-clé-site-turnstile
# Clé secrète (côté serveur uniquement) — vide en dev → vérif désactivée
TURNSTILE_SECRET_KEY=votre-clé-secrète-turnstile

# ─── Admin ─────────────────────────────────────────────────
# Optionnel : seed email pour le premier admin
ADMIN_SEED_EMAIL=admin@escen.university
# Optionnel : seed mot de passe (défaut: ESCEN2026!)
ADMIN_SEED_PASSWORD=votre-mot-de-passe-admin

# ─── Resend (emails d'alerte anti-fraude) ──────────────────
RESEND_API_KEY=votre-clé-api-resend
# Dev : onboarding@resend.dev — Prod : alerts@votre-domaine.fr (domaine vérifié)
RESEND_EMAIL_FROM=onboarding@resend.dev
# Destinataire des alertes (avec onboarding@resend.dev : l'email du compte Resend)
RESEND_ALERT_TO=admin@escen.university
